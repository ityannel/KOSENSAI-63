rules_version = '2';
// 第63回 函館高専祭の Firestore の読み書きのルール（下書き）。
// ※ 公開する前に、Firebase コンソールにいま入っているルールと見くらべること（ここで消える許可がないか）。
// 公開：npx firebase-tools deploy --only firestore:rules --project enishi-7f43f
//
// だれが何をできるか
//   本部（staff/crowd.html・staff/posts.html にメールとパスワードでログインした人）：お知らせ・混雑・実況・みんなの声の管理
//   来場者：読むだけ。みんなの声を書く・報告するときだけ「匿名ログイン」（名前なしの印）を使う
//   app/（模擬店・クイズ）：いまの作りのまま（ログインなしで書く）。ただし書きかえられる項目はしぼる
service cloud.firestore {
  match /databases/{database}/documents {
    // 本部：メールとパスワードでログインした人（匿名ログインの来場者はふくまない）
    function isStaff() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isVisitor() {
      return request.auth != null;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- トップページ・地図（site/） ----------
    match /site_live/{id} { allow read: if true; allow write: if isStaff(); }
    match /crowd/{venue}  { allow read: if true; allow write: if isStaff(); }
    match /chatter/{id}   { allow read: if true; allow write: if isStaff(); }
    // 見ている人の数：n を 1 ずつ足すだけ
    match /presence/{w} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    // ---------- みんなの声（site/assets/posts.js） ----------
    // 書かせない言葉（posts.js の NG と同じもの）
    function clean(t) {
      return !t.lower().matches('(?s).*(死ね|しね|殺す|ころす|きもい|キモい|キモイ|きしょい|うざい|ウザい|ブス|ぶす|デブ|でぶ|バカ|ばか|あほ|アホ|消えろ|きえろ|ガイジ|がいじ|ちんこ|まんこ|セックス|せっくす|レイプ|れいぷ|fuck|shit).*');
    }
    match /posts/{id} {
      allow read: if true;
      // 書く：自分の印・文字数・★・報告0・非表示なし、かつ 60 秒に1回（users_meta を同じ書き込みで更新）
      allow create: if isVisitor()
        && request.resource.data.keys().hasOnly(['kind', 'place', 'shop', 'stars', 'text', 'has_photo', 'uid', 'created_at', 'reports', 'hidden', 'reply_to'])
        && (request.resource.data.get('reply_to', null) == null || (request.resource.data.reply_to is string && request.resource.data.reply_to.size() <= 40))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['review', 'post']
        && request.resource.data.place is string && request.resource.data.place.size() <= 40   // "" は場所なし
        && request.resource.data.text is string && request.resource.data.text.size() <= 140 && clean(request.resource.data.text)
        && (request.resource.data.kind == 'post' || (request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5))
        && (request.resource.data.shop == null || (request.resource.data.shop is string && request.resource.data.shop.size() <= 60))
        && request.resource.data.has_photo is bool
        && request.resource.data.created_at == request.time
        && request.resource.data.reports == 0 && request.resource.data.hidden == false
        && getAfter(/databases/$(database)/documents/users_meta/$(request.auth.uid)).data.last_post == request.time
        && (!exists(/databases/$(database)/documents/users_meta/$(request.auth.uid))
            || get(/databases/$(database)/documents/users_meta/$(request.auth.uid)).data.last_post < request.time - duration.value(60, 's'));
      // 報告：reports を1つ足すだけ（同じ書き込みで post_reports に自分の報告を作る＝1人1回）
      // いいね：likes を1つ足す（post_likes を作る）か、1つ引く（自分の post_likes を消す）だけ
      allow update: if isStaff()
        || (isVisitor() && onlyChanges(['reports']) && request.resource.data.reports == resource.data.reports + 1
            && !exists(/databases/$(database)/documents/post_reports/$(id + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/post_reports/$(id + '_' + request.auth.uid)))
        || (isVisitor() && onlyChanges(['likes'])
            && ((request.resource.data.likes == resource.data.get('likes', 0) + 1
                 && !exists(/databases/$(database)/documents/post_likes/$(id + '_' + request.auth.uid))
                 && existsAfter(/databases/$(database)/documents/post_likes/$(id + '_' + request.auth.uid)))
             || (request.resource.data.likes == resource.data.get('likes', 0) - 1
                 && exists(/databases/$(database)/documents/post_likes/$(id + '_' + request.auth.uid))
                 && !existsAfter(/databases/$(database)/documents/post_likes/$(id + '_' + request.auth.uid)))));
      allow delete: if isStaff();
    }
    match /post_photos/{id} {
      allow read: if true;
      allow create: if isVisitor() && request.resource.data.keys().hasOnly(['data', 'uid']) && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 750000
        && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid;
      allow delete: if isStaff();
    }
    match /post_reports/{rid} {
      allow read: if isStaff();
      allow create: if isVisitor() && request.resource.data.uid == request.auth.uid && rid == request.resource.data.post + '_' + request.auth.uid;
      allow delete: if isStaff();
    }
    match /post_likes/{lid} {
      allow read: if isStaff();
      allow create: if isVisitor() && request.resource.data.keys().hasOnly(['post', 'uid', 'at']) && request.resource.data.uid == request.auth.uid
        && lid == request.resource.data.post + '_' + request.auth.uid;
      allow delete: if isVisitor() && resource.data.uid == request.auth.uid;
    }
    match /users_meta/{uid} {
      allow read: if isVisitor() && request.auth.uid == uid;
      allow write: if isVisitor() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['last_post']) && request.resource.data.last_post == request.time;
    }

    // ---------- app/（模擬店の待ち時間・クイズ）：いまの作りのまま動くように ----------
    match /shops/{id} {
      allow read: if true;
      allow update: if onlyChanges(['status']) && request.resource.data.status in ['normal', '10min', '20min', 'soldout'];
      allow create, delete: if isStaff();
    }
    match /quiz_control/{id} { allow read: if true; allow write: if true; }   // app/portal.html（ログインなし）
    match /quiz_answers/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if onlyChanges(['is_claimed']) && request.resource.data.is_claimed == true;   // app/claim.html
    }
  }
}
